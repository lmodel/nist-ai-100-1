# metamodel_version: 1.12.0
# version: 1.0.0
BASE <https://w3id.org/lmodel/nist-ai-100-1/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX linkml: <https://w3id.org/linkml/>
PREFIX schema1: <http://schema.org/>


linkml:String xsd:string

linkml:Integer xsd:integer

linkml:Boolean xsd:boolean

linkml:Float xsd:float

linkml:Double xsd:double

linkml:Decimal xsd:decimal

linkml:Time xsd:time

linkml:Date xsd:date

linkml:Datetime xsd:dateTime

linkml:DateOrDatetime linkml:DateOrDatetime

linkml:Uriorcurie IRI

linkml:Curie xsd:string

linkml:Uri IRI

linkml:Ncname xsd:string

linkml:Objectidentifier IRI

linkml:Nodeidentifier NONLITERAL

linkml:Jsonpointer xsd:string

linkml:Jsonpath xsd:string

linkml:Sparqlpath xsd:string

<AiRmfFunctionIdentifier> xsd:string

<AiRmfCategoryIdentifier> xsd:string

<AiRmfSubcategoryIdentifier> xsd:string

<AiRmfSuggestedActionIdentifier> xsd:string

<AiRmfDocumentationIdentifier> xsd:string

<AiRmfActor> CLOSED {
    (  $<AiRmfActor_tes> (  &<AiRmfRecord_tes> ;
          rdf:type [ <Record> ] ? ;
          <ai_rmf_actor_tasks> [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#ai_design>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#ai_development>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#ai_deployment>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#operation_and_monitoring>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#tevv>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#human_factors>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#domain_expert>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#ai_impact_assessment>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#procurement>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#governance_and_oversight>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#third_party_entities>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#end_users>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#affected_individuals_and_communities>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#other_ai_actors>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#general_public> ] * ;
          <ai_rmf_actor_audience> [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfAudience#primary>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfAudience#informing> ] ? ;
          <ai_rmf_actor_lifecycle_stages> [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#plan_and_design>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#collect_and_process_data>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#build_and_use_model>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#verify_and_validate>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#deploy_and_use>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#operate_and_monitor>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#use_or_impacted_by> ] *
       ) ;
       rdf:type [ <AiActor> ]
    )
}

<AiRmfActorTask> CLOSED {
    (  $<AiRmfActorTask_tes> (  schema1:description @linkml:String ? ;
          <ai_rmf_actor_task_name> [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#ai_design>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#ai_development>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#ai_deployment>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#operation_and_monitoring>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#tevv>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#human_factors>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#domain_expert>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#ai_impact_assessment>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#procurement>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#governance_and_oversight>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#third_party_entities>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#end_users>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#affected_individuals_and_communities>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#other_ai_actors>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#general_public> ] ;
          <ai_rmf_actor_task_is_additional_actor> @linkml:Boolean ? ;
          <ai_rmf_actor_task_representative_actors> @linkml:String *
       ) ;
       rdf:type [ <ActorTask> ] ?
    )
}

<AiRmfAttribute> CLOSED {
    (  $<AiRmfAttribute_tes> (  schema1:name @linkml:String ;
          schema1:description @linkml:String ? ;
          <ai_rmf_attribute_number> @linkml:Integer
       ) ;
       rdf:type [ <Attribute> ] ?
    )
}

<AiRmfBias> CLOSED {
    (  $<AiRmfBias_tes> (  &<AiRmfRecord_tes> ;
          rdf:type [ <Record> ] ? ;
          <ai_rmf_bias_categories> [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfBiasCategory#systemic>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfBiasCategory#computational_and_statistical>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfBiasCategory#human_cognitive> ] +
       ) ;
       rdf:type [ <Bias> ]
    )
}

<AiRmfCategory> CLOSED {
    (  $<AiRmfCategory_tes> (  <ai_rmf_category_id> @<AiRmfCategoryIdentifier> ;
          schema1:description @linkml:String ;
          <ai_rmf_category_subcategories> @<AiRmfSubcategory> *
       ) ;
       rdf:type [ <Category> ] ?
    )
}

<AiRmfDimension> CLOSED {
    (  $<AiRmfDimension_tes> (  schema1:description @linkml:String ? ;
          <ai_rmf_dimension_name> [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfDimensionName#application_context>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfDimensionName#data_and_input>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfDimensionName#ai_model>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfDimensionName#task_and_output>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfDimensionName#people_and_planet> ] ;
          <ai_rmf_dimension_audience> [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfAudience#primary>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfAudience#informing> ]
       ) ;
       rdf:type [ <Dimension> ] ?
    )
}

<AiRmfDocumentationItem> CLOSED {
    (  $<AiRmfDocumentationItem_tes> (  <ai_rmf_documentation_id> @<AiRmfDocumentationIdentifier> ;
          schema1:description @linkml:String
       ) ;
       rdf:type [ <DocumentationItem> ] ?
    )
}

<AiRmfFramework> CLOSED {
    (  $<AiRmfFramework_tes> (  <ai_rmf_version> @linkml:String ;
          <ai_rmf_functions> @<AiRmfFunction> + ;
          <ai_rmf_characteristics> @<AiRmfTrustworthinessCharacteristic> * ;
          <ai_rmf_dimensions> @<AiRmfDimension> * ;
          <ai_rmf_lifecycle_stages> @<AiRmfLifecycleStage> * ;
          <ai_rmf_actor_task_list> @<AiRmfActorTask> * ;
          <ai_rmf_management_challenges> @<AiRmfManagementChallenge> * ;
          <ai_rmf_specific_risks> @<AiRmfSpecificRisk> * ;
          <ai_rmf_human_ai_issues> @<AiRmfHumanAiIssue> * ;
          <ai_rmf_attributes> @<AiRmfAttribute> *
       ) ;
       rdf:type [ <Framework> ] ?
    )
}

<AiRmfFunction> CLOSED {
    (  $<AiRmfFunction_tes> (  <ai_rmf_function_id> @<AiRmfFunctionIdentifier> ;
          schema1:description @linkml:String ? ;
          <ai_rmf_function_categories> @<AiRmfCategory> *
       ) ;
       rdf:type [ <Function> ] ?
    )
}

<AiRmfHarm> CLOSED {
    (  $<AiRmfHarm_tes> (  &<AiRmfImpact_tes> ;
          rdf:type [ <Impact> ] ? ;
          <ai_rmf_harm_category> [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarmCategory#people>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarmCategory#organization>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarmCategory#ecosystem> ] ;
          <ai_rmf_harm_example> [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarmExample#individual>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarmExample#group_or_community>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarmExample#societal>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarmExample#business_operations>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarmExample#security_breach_or_monetary_loss>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarmExample#reputation>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarmExample#interdependent_elements>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarmExample#financial_or_supply_systems>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarmExample#natural_resources_and_environment> ] ?
       ) ;
       rdf:type [ <Harm> ]
    )
}

<AiRmfHumanAiIssue> CLOSED {
    (  $<AiRmfHumanAiIssue_tes> (  schema1:name @linkml:String ;
          schema1:description @linkml:String ? ;
          <ai_rmf_human_ai_issue_number> @linkml:Integer
       ) ;
       rdf:type [ <HumanAiIssue> ] ?
    )
}

<AiRmfImpact>  (
    CLOSED {
       (  $<AiRmfImpact_tes> (  &<AiRmfRecord_tes> ;
             rdf:type [ <Record> ] ? ;
             <ai_rmf_likelihood> @linkml:String ? ;
             <ai_rmf_magnitude> @linkml:String ? ;
             <ai_rmf_impact_direction> [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfImpactDirection#positive>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfImpactDirection#negative>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfImpactDirection#both> ] ;
             <ai_rmf_impact_affected_parties> [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfAffectedParty#individuals>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfAffectedParty#groups>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfAffectedParty#communities>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfAffectedParty#organizations>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfAffectedParty#society>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfAffectedParty#environment>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfAffectedParty#planet> ] *
          ) ;
          rdf:type [ <Impact> ]
       )
    } OR @<AiRmfHarm>
)

<AiRmfLifecycleStage> CLOSED {
    (  $<AiRmfLifecycleStage_tes> (  schema1:description @linkml:String ? ;
          <ai_rmf_lifecycle_stage_name> [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#plan_and_design>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#collect_and_process_data>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#build_and_use_model>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#verify_and_validate>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#deploy_and_use>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#operate_and_monitor>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#use_or_impacted_by> ] ;
          <ai_rmf_lifecycle_stage_dimension> [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfDimensionName#application_context>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfDimensionName#data_and_input>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfDimensionName#ai_model>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfDimensionName#task_and_output>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfDimensionName#people_and_planet> ] ;
          <ai_rmf_lifecycle_stage_tevv> @linkml:String ? ;
          <ai_rmf_lifecycle_stage_representative_actors> @linkml:String *
       ) ;
       rdf:type [ <LifecycleStage> ] ?
    )
}

<AiRmfManagementChallenge> CLOSED {
    (  $<AiRmfManagementChallenge_tes> (  schema1:description @linkml:String ? ;
          <ai_rmf_management_challenge_name> [
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfManagementChallengeName#risk_measurement>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfManagementChallengeName#risk_tolerance>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfManagementChallengeName#risk_prioritization>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfManagementChallengeName#organizational_integration_and_management_of_risk>
             ] ;
          <ai_rmf_management_challenge_measurement_challenges> @<AiRmfMeasurementChallenge> *
       ) ;
       rdf:type [ <ManagementChallenge> ] ?
    )
}

<AiRmfMeasurementChallenge> CLOSED {
    (  $<AiRmfMeasurementChallenge_tes> (  schema1:description @linkml:String ? ;
          <ai_rmf_measurement_challenge_name> [
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfMeasurementChallengeName#third_party_software_hardware_and_data>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfMeasurementChallengeName#tracking_emergent_risks>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfMeasurementChallengeName#availability_of_reliable_metrics>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfMeasurementChallengeName#risk_at_different_lifecycle_stages>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfMeasurementChallengeName#risk_in_real_world_settings>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfMeasurementChallengeName#inscrutability>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfMeasurementChallengeName#human_baseline> ]
       ) ;
       rdf:type [ <MeasurementChallenge> ] ?
    )
}

<AiRmfProfile> CLOSED {
    (  $<AiRmfProfile_tes> (  &<AiRmfRecord_tes> ;
          rdf:type [ <Record> ] ? ;
          <ai_rmf_profile_kinds> [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfProfileKind#use_case>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfProfileKind#current>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfProfileKind#target>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfProfileKind#cross_sectoral> ] + ;
          <ai_rmf_profile_setting> @linkml:String ? ;
          <ai_rmf_profile_subcategories> @<AiRmfSubcategoryIdentifier> *
       ) ;
       rdf:type [ <Profile> ]
    )
}

<AiRmfRecord>  (
    @<AiRmfActor> OR @<AiRmfBias> OR @<AiRmfImpact> OR @<AiRmfProfile> OR @<AiRmfRisk> OR @<AiRmfRiskTolerance> OR @<AiRmfSystem>
)

<AiRmfRecord_struct> {
    (  $<AiRmfRecord_tes> (  schema1:name @linkml:String ? ;
          schema1:description @linkml:String ?
       ) ;
       rdf:type [ <Record> ]
    )
}

<AiRmfResidualRisk> CLOSED {
    (  $<AiRmfResidualRisk_tes> (  &<AiRmfRisk_tes> ;
          rdf:type [ <Risk> ] ?
       ) ;
       rdf:type [ <ResidualRisk> ]
    )
}

<AiRmfResource> CLOSED {
    (  $<AiRmfResource_tes> (  schema1:name @linkml:String ;
          <ai_rmf_resource_uuid> @linkml:String ;
          <ai_rmf_resource_address> @linkml:Uri ?
       ) ;
       rdf:type [ <Resource> ] ?
    )
}

<AiRmfRisk>  (
    CLOSED {
       (  $<AiRmfRisk_tes> (  &<AiRmfRecord_tes> ;
             rdf:type [ <Record> ] ? ;
             <ai_rmf_likelihood> @linkml:String ? ;
             <ai_rmf_magnitude> @linkml:String ? ;
             <ai_rmf_risk_system> @<AiRmfSystem> ? ;
             <ai_rmf_risk_impacts> @<AiRmfImpact> * ;
             <ai_rmf_risk_characteristics> [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfCharacteristicName#valid_and_reliable>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfCharacteristicName#safe>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfCharacteristicName#secure_and_resilient>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfCharacteristicName#accountable_and_transparent>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfCharacteristicName#explainable_and_interpretable>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfCharacteristicName#privacy_enhanced>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfCharacteristicName#fair_with_harmful_bias_managed> ] * ;
             <ai_rmf_risk_lifecycle_stages> [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#plan_and_design>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#collect_and_process_data>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#build_and_use_model>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#verify_and_validate>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#deploy_and_use>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#operate_and_monitor>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#use_or_impacted_by> ] * ;
             <ai_rmf_risk_responses> [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfRiskResponse#mitigating>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfRiskResponse#transferring>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfRiskResponse#avoiding>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfRiskResponse#accepting> ] *
          ) ;
          rdf:type [ <Risk> ]
       )
    } OR @<AiRmfResidualRisk>
)

<AiRmfRiskTolerance> CLOSED {
    (  $<AiRmfRiskTolerance_tes> (  &<AiRmfRecord_tes> ;
          rdf:type [ <Record> ] ? ;
          <ai_rmf_risk_tolerance_holder> @<AiRmfActor> ? ;
          <ai_rmf_risk_tolerance_influences> @linkml:String *
       ) ;
       rdf:type [ <RiskTolerance> ]
    )
}

<AiRmfSpecificRisk> CLOSED {
    (  $<AiRmfSpecificRisk_tes> (  schema1:name @linkml:String ;
          schema1:description @linkml:String ? ;
          <ai_rmf_specific_risk_position> @linkml:Integer
       ) ;
       rdf:type [ <SpecificRisk> ] ?
    )
}

<AiRmfSubcategory> CLOSED {
    (  $<AiRmfSubcategory_tes> (  <ai_rmf_subcategory_id> @<AiRmfSubcategoryIdentifier> ;
          schema1:description @linkml:String ;
          <ai_rmf_subcategory_about> @linkml:String * ;
          <ai_rmf_subcategory_suggested_actions> @<AiRmfSuggestedAction> * ;
          <ai_rmf_subcategory_documentation> @<AiRmfDocumentationItem> * ;
          <ai_rmf_subcategory_transparency_resources> @<AiRmfResource> * ;
          <ai_rmf_subcategory_references> @<AiRmfResource> * ;
          <ai_rmf_subcategory_ai_actors> [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#ai_design>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#ai_development>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#ai_deployment>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#operation_and_monitoring>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#tevv>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#human_factors>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#domain_expert>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#ai_impact_assessment>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#procurement>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#governance_and_oversight>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#third_party_entities>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#end_users>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#affected_individuals_and_communities>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#other_ai_actors>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#general_public> ] * ;
          <ai_rmf_subcategory_topics> @linkml:String *
       ) ;
       rdf:type [ <Subcategory> ] ?
    )
}

<AiRmfSuggestedAction> CLOSED {
    (  $<AiRmfSuggestedAction_tes> (  <ai_rmf_suggested_action_id> @<AiRmfSuggestedActionIdentifier> ;
