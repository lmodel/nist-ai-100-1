	skos:inScheme nist_ai_100_1:nist_ai_100_1_foundations ;
	skos:note "Section 1.2.3 defines residual risk this way, after ISO Guide 73. MANAGE 1.4 instead calls negative residual risks the sum of all unmitigated risks." .
