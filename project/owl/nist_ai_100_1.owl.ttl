	a owl:Class ;
	rdfs:label "risk_prioritization" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfManagementChallengeName ;
	skos:definition "Eliminating all negative risk is unrealistic, so effort goes first to the highest risks in a context of use." .
