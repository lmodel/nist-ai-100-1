	a owl:Class ;
	rdfs:label "risk_in_real_world_settings" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfMeasurementChallengeName ;
	skos:definition "What a laboratory measures may differ from what emerges in operation." .
