	skos:definition "The Playbook's discussion of the outcome." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_rmf_core .
nist_ai_100_1:ai_rmf_subcategory_ai_actors a owl:ObjectProperty ;
	rdfs:label "ai_rmf_subcategory_ai_actors" ;
	skos:definition "The AI actors the Playbook tags the outcome with." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_rmf_core .
nist_ai_100_1:ai_rmf_subcategory_documentation a owl:ObjectProperty ;
	rdfs:label "ai_rmf_subcategory_documentation" ;
	skos:definition "What the Playbook suggests an organization document, mostly as questions." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_rmf_core .
nist_ai_100_1:ai_rmf_subcategory_id a owl:DatatypeProperty ;
	rdfs:label "ai_rmf_subcategory_id" ;
	rdfs:range xsd:string ;
	skos:definition "The subcategory's identifier, such as GOVERN 1.1." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_base .
nist_ai_100_1:ai_rmf_subcategory_references a owl:ObjectProperty ;
	rdfs:label "ai_rmf_subcategory_references" ;
	skos:definition "The Playbook's references for the outcome." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_rmf_core .
nist_ai_100_1:ai_rmf_subcategory_suggested_actions a owl:ObjectProperty ;
	rdfs:label "ai_rmf_subcategory_suggested_actions" ;
	skos:definition "The steps the Playbook suggests towards the outcome. They are voluntary and are not a checklist." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_rmf_core .
nist_ai_100_1:ai_rmf_subcategory_topics a owl:DatatypeProperty ;
	rdfs:label "ai_rmf_subcategory_topics" ;
	skos:definition "The topics the Playbook tags the outcome with. NIST keeps no closed list of them." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_rmf_core .
nist_ai_100_1:ai_rmf_subcategory_transparency_resources a owl:ObjectProperty ;
	rdfs:label "ai_rmf_subcategory_transparency_resources" ;
	skos:definition "The sources the Playbook names as AI transparency resources." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_rmf_core .
nist_ai_100_1:ai_rmf_suggested_action_id a owl:DatatypeProperty ;
	rdfs:label "ai_rmf_suggested_action_id" ;
	rdfs:range xsd:string ;
	skos:definition "The suggested action's identifier, such as SA-GOVERN_1.1-1." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_rmf_core .
nist_ai_100_1:ai_rmf_system_lifecycle_stages a owl:ObjectProperty ;
	rdfs:label "ai_rmf_system_lifecycle_stages" ;
	skos:definition "The lifecycle stages the record covers." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_foundations .
nist_ai_100_1:ai_rmf_version a owl:DatatypeProperty ;
	rdfs:label "ai_rmf_version" ;
	skos:definition "The edition in NIST's two-number form, such as 1.0." ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .
nist_ai_100_1:description a owl:DatatypeProperty ;
	rdfs:label "description" ;
	skos:definition "What the element says or is." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_base ;
	skos:note "It carries the IRI of LOKF's description, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one description key." .
nist_ai_100_1:title a owl:DatatypeProperty ;
	rdfs:label "title" ;
	skos:definition "The element's name." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_base ;
	skos:note "It carries the IRI of LOKF's title, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one title key." .
