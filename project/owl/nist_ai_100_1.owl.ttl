xsd:string a rdfs:Datatype ;
	owl:equivalentClass _:c14n435 , _:c14n437 , _:c14n439 , _:c14n441 , _:c14n443 .
<https://w3id.org/lmodel/nist-ai-100-1.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://doi.org/10.6028/NIST.AI.100-1> ;
	dcterms:title "NIST AI Risk Management Framework (AI RMF 1.0)" ;
	pav:version "1.0.0" ;
	a owl:Ontology ;
	rdfs:label "nist_ai_100_1" ;
	rdfs:seeAlso <https://airc.nist.gov/airmf-resources/playbook/> , <https://github.com/usnistgov/oscal-content/tree/v1.6.0/nist.gov/AI100-1/ver1> , <https://lmodel.github.io/nist-ai-100-1> , <https://www.nist.gov/itl/ai-risk-management-framework> ;
	skos:definition "A LinkML model of the Artificial Intelligence Risk Management Framework (AI RMF 1.0), which NIST publishes as NIST AI 100-1: the Core's functions, categories and subcategories with their Playbook material, the framing of risk and harm, the trustworthiness characteristics, the lifecycle and AI actors, profiles and the lists of the appendices." ;
	skos:note "The publication is a work of the United States Government. NOTICE says what it and the catalog allow. The schema's descriptions are this project's own words; NIST's text of the Core and the Playbook is in src/nist_ai_100_1/data/, built from upstream/." , "The version is the AI RMF edition, and source is the publication's digital object identifier. NIST numbers the framework 1.0 and its catalog of it 1.0.0. The release tags are the schema's own versions, and scripts/check_upstream_release.py reports when NIST changes the publication, the catalog or the Playbook." ;
	nist_ai_100_1:cprt_framework_version "AI_100_1_0_0" ;
	nist_ai_100_1:oscal_content_commit "f0de6d8d8c059d374f15e0ae07508d82e370fc1d" ;
	nist_ai_100_1:oscal_content_tag "v1.6.0" ;
	nist_ai_100_1:publication_date "2023-01" .
nist_ai_100_1:AiRmfActor a owl:Class ;
	rdfs:label "AiRmfActor" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfRecord , _:c14n128 , _:c14n147 , _:c14n160 , _:c14n256 , _:c14n259 , _:c14n261 , _:c14n309 ;
	skos:broadMatch prov:Agent ;
	skos:definition "An organization or individual with an active role in an AI system's lifecycle." ;
	skos:exactMatch nist_ai_100_1:AiActor ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_foundations .
nist_ai_100_1:AiRmfActorTask a owl:Class ;
	rdfs:label "AiRmfActorTask" ;
	rdfs:subClassOf _:c14n110 , _:c14n136 , _:c14n142 , _:c14n164 , _:c14n189 , _:c14n217 , _:c14n236 , _:c14n271 , _:c14n343 , _:c14n56 , _:c14n94 ;
	skos:definition "A task or additional AI actor of Appendix A." ;
	skos:exactMatch nist_ai_100_1:ActorTask ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_foundations .
nist_ai_100_1:AiRmfActorTaskName\#affected_individuals_and_communities dcterms:title "Affected individuals/communities" ;
	a owl:Class ;
	rdfs:label "affected_individuals_and_communities" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfActorTaskName ;
	skos:altLabel "Affected Individuals and Communities" ;
	skos:definition "Those directly or indirectly affected by the system or its output, whether or not they interact with it." .
nist_ai_100_1:AiRmfActorTaskName\#ai_deployment dcterms:title "AI Deployment" ;
	a owl:Class ;
	rdfs:label "ai_deployment" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfActorTaskName ;
	skos:definition "Deciding how the system is used and putting it into production, including pilots and compliance checks." .
nist_ai_100_1:AiRmfActorTaskName\#ai_design dcterms:title "AI Design" ;
	a owl:Class ;
	rdfs:label "ai_design" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfActorTaskName ;
	skos:definition "Setting what the system is for, planning and designing it, and gathering and preparing its data." .
nist_ai_100_1:AiRmfActorTaskName\#ai_development dcterms:title "AI Development" ;
	a owl:Class ;
	rdfs:label "ai_development" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfActorTaskName ;
	skos:definition "Providing the initial infrastructure, and creating, selecting, calibrating, training and testing models." .
nist_ai_100_1:AiRmfActorTaskName\#ai_impact_assessment dcterms:title "AI Impact Assessment" ;
	a owl:Class ;
	rdfs:label "ai_impact_assessment" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfActorTaskName ;
	skos:definition "Assessing accountability, harmful bias, impacts, product safety, liability and security." .
nist_ai_100_1:AiRmfActorTaskName\#domain_expert dcterms:title "Domain Expert" ;
	a owl:Class ;
	rdfs:label "domain_expert" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfActorTaskName ;
	skos:altLabel "Domain Experts" ;
	skos:definition "Giving knowledge of the sector or setting where the system is used." .
nist_ai_100_1:AiRmfActorTaskName\#end_users dcterms:title "End users" ;
	a owl:Class ;
	rdfs:label "end_users" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfActorTaskName ;
	skos:altLabel "End Users" , "End-Users" ;
	skos:definition "The people or groups who use the system, whether new to technology or expert in AI." .
nist_ai_100_1:AiRmfActorTaskName\#general_public dcterms:title "General public" ;
	a owl:Class ;
	rdfs:label "general_public" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfActorTaskName ;
	skos:definition "Those most likely to experience the impacts directly, who may motivate what other AI actors do." .
nist_ai_100_1:AiRmfActorTaskName\#governance_and_oversight dcterms:title "Governance and Oversight" ;
	a owl:Class ;
	rdfs:label "governance_and_oversight" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfActorTaskName ;
	skos:definition "Holding management, fiduciary and legal authority for the organization where the system is designed, developed or deployed." .
nist_ai_100_1:AiRmfActorTaskName\#human_factors dcterms:title "Human Factors" ;
	a owl:Class ;
	rdfs:label "human_factors" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfActorTaskName ;
	skos:definition "Human-centered design and evaluation, involving end users and bringing context-specific norms and values into design." .
nist_ai_100_1:AiRmfActorTaskName\#operation_and_monitoring dcterms:title "Operation and Monitoring" ;
	a owl:Class ;
	rdfs:label "operation_and_monitoring" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfActorTaskName ;
	skos:definition "Running the system and regularly assessing its output and impacts." .
nist_ai_100_1:AiRmfActorTaskName\#other_ai_actors dcterms:title "Other AI actors" ;
	a owl:Class ;
	rdfs:label "other_ai_actors" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfActorTaskName ;
	skos:definition "Those who may provide norms or guidance on AI risk, such as standards bodies, advocacy groups and researchers." .
nist_ai_100_1:AiRmfActorTaskName\#procurement dcterms:title "Procurement" ;
	a owl:Class ;
	rdfs:label "procurement" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfActorTaskName ;
	skos:definition "Acquiring AI from another party, under financial, legal or policy authority." .
nist_ai_100_1:AiRmfActorTaskName\#tevv dcterms:title "Test, Evaluation, Verification, and Validation (TEVV)" ;
	a owl:Class ;
	rdfs:label "tevv" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfActorTaskName ;
	skos:altLabel "TEVV" ;
	skos:definition "Examining the system or its components and finding and fixing problems, throughout the lifecycle." .
nist_ai_100_1:AiRmfActorTaskName\#third_party_entities dcterms:title "Third-party entities" ;
	a owl:Class ;
	rdfs:label "third_party_entities" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfActorTaskName ;
	skos:definition "Outside organizations that supply or evaluate the data, models, systems or services an organization acquires." .
nist_ai_100_1:AiRmfActorTaskName a owl:Class ;
	rdfs:label "AiRmfActorTaskName" ;
	owl:unionOf _:c14n120 ;
	skos:definition "The ten AI actor tasks and five additional AI actors of Appendix A." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_base ;
	skos:note "One list holds both kinds because NIST tags them together: the Playbook under its AI Actors key, and AI 600-1 under AI Actor Tasks. Each alias is the spelling those tags use where it differs from the title in Appendix A." ;
	linkml:permissible_values nist_ai_100_1:AiRmfActorTaskName\#affected_individuals_and_communities , nist_ai_100_1:AiRmfActorTaskName\#ai_deployment , nist_ai_100_1:AiRmfActorTaskName\#ai_design , nist_ai_100_1:AiRmfActorTaskName\#ai_development , nist_ai_100_1:AiRmfActorTaskName\#ai_impact_assessment , nist_ai_100_1:AiRmfActorTaskName\#domain_expert , nist_ai_100_1:AiRmfActorTaskName\#end_users , nist_ai_100_1:AiRmfActorTaskName\#general_public , nist_ai_100_1:AiRmfActorTaskName\#governance_and_oversight , nist_ai_100_1:AiRmfActorTaskName\#human_factors , nist_ai_100_1:AiRmfActorTaskName\#operation_and_monitoring , nist_ai_100_1:AiRmfActorTaskName\#other_ai_actors , nist_ai_100_1:AiRmfActorTaskName\#procurement , nist_ai_100_1:AiRmfActorTaskName\#tevv , nist_ai_100_1:AiRmfActorTaskName\#third_party_entities .
nist_ai_100_1:AiRmfAffectedParty\#communities dcterms:title "Communities" ;
	a owl:Class ;
	rdfs:label "communities" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfAffectedParty ;
	skos:definition "Communities of people." .
nist_ai_100_1:AiRmfAffectedParty\#environment dcterms:title "The environment" ;
	a owl:Class ;
	rdfs:label "environment" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfAffectedParty ;
	skos:definition "The natural environment." .
nist_ai_100_1:AiRmfAffectedParty\#groups dcterms:title "Groups" ;
	a owl:Class ;
	rdfs:label "groups" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfAffectedParty ;
	skos:definition "Groups of people." .
nist_ai_100_1:AiRmfAffectedParty\#individuals dcterms:title "Individuals" ;
	a owl:Class ;
	rdfs:label "individuals" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfAffectedParty ;
	skos:definition "Particular people." .
nist_ai_100_1:AiRmfAffectedParty\#organizations dcterms:title "Organizations" ;
	a owl:Class ;
	rdfs:label "organizations" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfAffectedParty ;
	skos:definition "Organizations." .
nist_ai_100_1:AiRmfAffectedParty\#planet dcterms:title "The planet" ;
	a owl:Class ;
	rdfs:label "planet" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfAffectedParty ;
	skos:definition "The planet as a whole." .
nist_ai_100_1:AiRmfAffectedParty\#society dcterms:title "Society" ;
	a owl:Class ;
	rdfs:label "society" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfAffectedParty ;
	skos:definition "Society at large." .
nist_ai_100_1:AiRmfAffectedParty a owl:Class ;
	rdfs:label "AiRmfAffectedParty" ;
	owl:unionOf _:c14n159 ;
	skos:definition "Who section 1.1 says can experience negative impact or harm." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_foundations ;
	linkml:permissible_values nist_ai_100_1:AiRmfAffectedParty\#communities , nist_ai_100_1:AiRmfAffectedParty\#environment , nist_ai_100_1:AiRmfAffectedParty\#groups , nist_ai_100_1:AiRmfAffectedParty\#individuals , nist_ai_100_1:AiRmfAffectedParty\#organizations , nist_ai_100_1:AiRmfAffectedParty\#planet , nist_ai_100_1:AiRmfAffectedParty\#society .
nist_ai_100_1:AiRmfAttribute a owl:Class ;
	rdfs:label "AiRmfAttribute" ;
	rdfs:subClassOf _:c14n131 , _:c14n132 , _:c14n133 , _:c14n222 , _:c14n250 , _:c14n318 , _:c14n32 , _:c14n328 , _:c14n96 ;
	skos:definition "A key attribute of the AI RMF in Appendix D, which guided its development." ;
	skos:exactMatch nist_ai_100_1:Attribute ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_foundations .
nist_ai_100_1:AiRmfAudience\#informing dcterms:title "Informing audience" ;
	a owl:Class ;
	rdfs:label "informing" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfAudience ;
	skos:definition "AI actors in the People and Planet dimension, who inform the primary audience." .
nist_ai_100_1:AiRmfAudience\#primary dcterms:title "Primary audience" ;
	a owl:Class ;
	rdfs:label "primary" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfAudience ;
	skos:definition "AI actors who carry out or manage work on AI systems and drive their risk management." .
nist_ai_100_1:AiRmfAudience a owl:Class ;
	rdfs:label "AiRmfAudience" ;
	owl:unionOf _:c14n283 ;
	skos:definition "The two AI RMF audiences of section 2." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_foundations ;
	linkml:permissible_values nist_ai_100_1:AiRmfAudience\#informing , nist_ai_100_1:AiRmfAudience\#primary .
nist_ai_100_1:AiRmfBias a owl:Class ;
	rdfs:label "AiRmfBias" ;
	rdfs:seeAlso <https://doi.org/10.6028/NIST.SP.1270> ;
	rdfs:subClassOf nist_ai_100_1:AiRmfRecord , _:c14n193 , _:c14n286 ;
	skos:definition "A bias to consider and manage, sorted into NIST's three major categories." ;
	skos:exactMatch nist_ai_100_1:Bias ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_foundations .
nist_ai_100_1:AiRmfBiasCategory\#computational_and_statistical dcterms:title "Computational and statistical" ;
	a owl:Class ;
	rdfs:label "computational_and_statistical" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfBiasCategory ;
	skos:definition "In datasets and algorithms, often from systematic errors due to samples that are not representative." .
nist_ai_100_1:AiRmfBiasCategory\#human_cognitive dcterms:title "Human-cognitive" ;
	a owl:Class ;
	rdfs:label "human_cognitive" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfBiasCategory ;
	skos:definition "In how people perceive system information to decide, or think about what a system is for." .
nist_ai_100_1:AiRmfBiasCategory\#systemic dcterms:title "Systemic" ;
	a owl:Class ;
	rdfs:label "systemic" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfBiasCategory ;
	skos:definition "In datasets, in organizational norms and processes, and in the wider society that uses AI." .
nist_ai_100_1:AiRmfBiasCategory a owl:Class ;
	rdfs:label "AiRmfBiasCategory" ;
	rdfs:seeAlso <https://doi.org/10.6028/NIST.SP.1270> ;
	owl:unionOf _:c14n177 ;
	skos:definition "The three major categories of AI bias in section 3.7, each of which can occur without prejudice or discriminatory intent." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_foundations ;
	linkml:permissible_values nist_ai_100_1:AiRmfBiasCategory\#computational_and_statistical , nist_ai_100_1:AiRmfBiasCategory\#human_cognitive , nist_ai_100_1:AiRmfBiasCategory\#systemic .
nist_ai_100_1:AiRmfCategory a owl:Class ;
	rdfs:label "AiRmfCategory" ;
	rdfs:subClassOf _:c14n130 , _:c14n146 , _:c14n153 , _:c14n179 , _:c14n199 , _:c14n225 , _:c14n246 , _:c14n292 ;
	skos:broadMatch oscal:Control ;
	skos:definition "A group of related outcomes within a function, such as GOVERN 1, which Tables 1 to 4 state." ;
	skos:exactMatch nist_ai_100_1:Category ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_rmf_core ;
	skos:relatedMatch <https://w3id.org/lmodel/nist-csf-v2/Category> .
nist_ai_100_1:AiRmfCharacteristicName\#accountable_and_transparent dcterms:title "Accountable and Transparent" ;
	a owl:Class ;
	rdfs:label "accountable_and_transparent" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfCharacteristicName ;
	skos:definition "Answerable for outcomes, which rests on people being able to get information about the system and its outputs. Figure 4 shows it relating to all the others." .
nist_ai_100_1:AiRmfCharacteristicName\#explainable_and_interpretable dcterms:title "Explainable and Interpretable" ;
	a owl:Class ;
	rdfs:label "explainable_and_interpretable" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfCharacteristicName ;
	skos:definition "Its working can be represented (how a decision was made) and its output understood in context (why, and what it means for the user)." .
nist_ai_100_1:AiRmfCharacteristicName\#fair_with_harmful_bias_managed dcterms:title "Fair – with Harmful Bias Managed" ;
	a owl:Class ;
	rdfs:label "fair_with_harmful_bias_managed" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfCharacteristicName ;
	skos:definition "Addresses equality and equity, including harmful bias and discrimination, knowing that views of fairness differ across cultures and applications." .
nist_ai_100_1:AiRmfCharacteristicName\#privacy_enhanced dcterms:title "Privacy-Enhanced" ;
	a owl:Class ;
	rdfs:label "privacy_enhanced" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfCharacteristicName ;
	skos:definition "Guided by the norms and practices that protect human autonomy, identity and dignity, such as anonymity, confidentiality and control." .
nist_ai_100_1:AiRmfCharacteristicName\#safe dcterms:title "Safe" ;
	a owl:Class ;
	rdfs:label "safe" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfCharacteristicName ;
	skos:definition "Keeps people, property and the environment out of danger under defined conditions." .
nist_ai_100_1:AiRmfCharacteristicName\#secure_and_resilient dcterms:title "Secure and Resilient" ;
	a owl:Class ;
	rdfs:label "secure_and_resilient" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfCharacteristicName ;
	skos:definition "Withstands adverse events and recovers from them, and keeps confidentiality, integrity and availability through protections against attack." .
nist_ai_100_1:AiRmfCharacteristicName\#valid_and_reliable dcterms:title "Valid and Reliable" ;
	a owl:Class ;
	rdfs:label "valid_and_reliable" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfCharacteristicName ;
	skos:definition "Shown by evidence to meet the needs of its intended use, and works without failure over time. Figure 4 makes it a necessary condition for the others." .
nist_ai_100_1:AiRmfCharacteristicName a owl:Class ;
	rdfs:label "AiRmfCharacteristicName" ;
	owl:unionOf _:c14n337 ;
	skos:definition "The seven characteristics of trustworthy AI systems in section 3 of the publication." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_base ;
	linkml:permissible_values nist_ai_100_1:AiRmfCharacteristicName\#accountable_and_transparent , nist_ai_100_1:AiRmfCharacteristicName\#explainable_and_interpretable , nist_ai_100_1:AiRmfCharacteristicName\#fair_with_harmful_bias_managed , nist_ai_100_1:AiRmfCharacteristicName\#privacy_enhanced , nist_ai_100_1:AiRmfCharacteristicName\#safe , nist_ai_100_1:AiRmfCharacteristicName\#secure_and_resilient , nist_ai_100_1:AiRmfCharacteristicName\#valid_and_reliable .
nist_ai_100_1:AiRmfDimension a owl:Class ;
	rdfs:label "AiRmfDimension" ;
	rdfs:subClassOf _:c14n101 , _:c14n115 , _:c14n118 , _:c14n156 , _:c14n315 , _:c14n336 , _:c14n53 , _:c14n71 , _:c14n80 ;
	skos:definition "One of the five key socio-technical dimensions of an AI system in Figure 2." ;
	skos:exactMatch nist_ai_100_1:Dimension ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_foundations .
nist_ai_100_1:AiRmfDimensionName\#ai_model dcterms:title "AI Model" ;
	a owl:Class ;
	rdfs:label "ai_model" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfDimensionName ;
	skos:definition "The models built, used, verified and validated." .
nist_ai_100_1:AiRmfDimensionName\#application_context dcterms:title "Application Context" ;
	a owl:Class ;
	rdfs:label "application_context" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfDimensionName ;
	skos:definition "The setting the system is planned for and operated in." .
nist_ai_100_1:AiRmfDimensionName\#data_and_input dcterms:title "Data and Input" ;
	a owl:Class ;
	rdfs:label "data_and_input" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfDimensionName ;
	skos:definition "The data the system is built from and takes in." .
nist_ai_100_1:AiRmfDimensionName\#people_and_planet dcterms:title "People and Planet" ;
	a owl:Class ;
	rdfs:label "people_and_planet" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfDimensionName ;
	skos:definition "Human rights and the well-being of society and the planet, at the center of Figure 2." .
nist_ai_100_1:AiRmfDimensionName\#task_and_output dcterms:title "Task and Output" ;
	a owl:Class ;
	rdfs:label "task_and_output" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfDimensionName ;
	skos:definition "What the system does and produces once deployed." .
nist_ai_100_1:AiRmfDimensionName a owl:Class ;
	rdfs:label "AiRmfDimensionName" ;
	owl:unionOf _:c14n103 ;
	skos:definition "The key dimensions of an AI system in Figure 2." ;
	skos:inScheme nist_ai_100_1:nist_ai_100_1_foundations ;
	linkml:permissible_values nist_ai_100_1:AiRmfDimensionName\#ai_model , nist_ai_100_1:AiRmfDimensionName\#application_context , nist_ai_100_1:AiRmfDimensionName\#data_and_input , nist_ai_100_1:AiRmfDimensionName\#people_and_planet , nist_ai_100_1:AiRmfDimensionName\#task_and_output .
nist_ai_100_1:AiRmfDocumentationItem a owl:Class ;
