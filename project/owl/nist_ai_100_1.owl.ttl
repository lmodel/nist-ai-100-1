	rdfs:label "risk_at_different_lifecycle_stages" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfMeasurementChallengeName ;
	skos:definition "Results differ by stage, some risks stay latent, and AI actors see risk differently." .
