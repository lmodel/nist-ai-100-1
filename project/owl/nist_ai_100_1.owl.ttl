	a owl:Class ;
	rdfs:label "accepting" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfRiskResponse ;
	skos:definition "Bearing the risk without further action." .
nist_ai_100_1:AiRmfRiskResponse\#avoiding dcterms:title "Avoiding" ;
	a owl:Class ;
	rdfs:label "avoiding" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfRiskResponse ;
	skos:definition "Not carrying out what creates the risk." .
nist_ai_100_1:AiRmfRiskResponse\#mitigating dcterms:title "Mitigating" ;
	a owl:Class ;
	rdfs:label "mitigating" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfRiskResponse ;
	skos:definition "Reducing the likelihood or magnitude of the risk." .
