	a owl:Class ;
	rdfs:label "availability_of_reliable_metrics" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfMeasurementChallengeName ;
	skos:definition "There is no consensus on robust, verifiable methods, and metrics can be oversimplified or gamed." .
