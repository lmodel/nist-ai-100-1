	a owl:Class ;
	rdfs:label "third_party_software_hardware_and_data" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfMeasurementChallengeName ;
	skos:definition "Third-party parts can speed work, but their metrics may not match or be disclosed, and how they are used adds risk." .
nist_ai_100_1:AiRmfMeasurementChallengeName\#tracking_emergent_risks dcterms:title "Tracking emergent risks" ;
	a owl:Class ;
	rdfs:label "tracking_emergent_risks" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfMeasurementChallengeName ;
	skos:definition "New risks need identifying, tracking and measuring, which impact assessment helps with." .
