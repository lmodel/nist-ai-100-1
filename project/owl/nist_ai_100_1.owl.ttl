	a owl:Class ;
	rdfs:label "human_baseline" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfMeasurementChallengeName ;
	skos:definition "A system that augments or replaces human activity needs a baseline, which is hard to systematize." .
