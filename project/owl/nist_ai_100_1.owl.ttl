	a owl:Class ;
	rdfs:label "risk_measurement" ;
	rdfs:subClassOf nist_ai_100_1:AiRmfManagementChallengeName ;
	skos:definition "AI risks that are poorly defined or understood are hard to measure, which does not mean they are high or low." .
