	linkml:base "int" ;
	linkml:definition_uri "https://w3id.org/linkml/Integer"^^xsd:anyURI ;
	linkml:description "An integer" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#integer"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-ai-100-1/interdependent_elements> dcterms:title "Interconnected and interdependent elements and resources" ;
	linkml:description "To parts and resources that depend on each other." .
<https://w3id.org/lmodel/nist-ai-100-1/jsonpath> dcterms:conformsTo "https://www.ietf.org/archive/id/draft-goessner-dispatch-jsonpath-00.html" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpath\"." ;
