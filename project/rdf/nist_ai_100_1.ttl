	a linkml:SchemaDefinition ;
	rdfs:seeAlso "https://airc.nist.gov/airmf-resources/playbook/"^^xsd:anyURI , "https://github.com/usnistgov/oscal-content/tree/v1.6.0/nist.gov/AI100-1/ver1"^^xsd:anyURI , "https://lmodel.github.io/nist-ai-100-1"^^xsd:anyURI , "https://www.nist.gov/itl/ai-risk-management-framework"^^xsd:anyURI ;
	skos:note "The publication is a work of the United States Government. NOTICE says what it and the catalog allow. The schema's descriptions are this project's own words; NIST's text of the Core and the Playbook is in src/nist_ai_100_1/data/, built from upstream/." , "The version is the AI RMF edition, and source is the publication's digital object identifier. NIST numbers the framework 1.0 and its catalog of it 1.0.0. The release tags are the schema's own versions, and scripts/check_upstream_release.py reports when NIST changes the publication, the catalog or the Playbook." ;
