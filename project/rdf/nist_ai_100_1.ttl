<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_lifecycle_stage_tevv> a linkml:SlotDefinition ;
	linkml:description "The testing, evaluation, verification and validation (TEVV) Figure 3 gives the stage." .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_lifecycle_stages> a linkml:SlotDefinition ;
	linkml:description "The lifecycle stages of Figure 3." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStage> .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_likelihood> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-ai-100-1/nist_ai_100_1_foundations"^^xsd:anyURI ;
	skos:note "The publication sets no scale, and the Playbook allows qualitative ones, so this is text rather than a probability." ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_likelihood"^^xsd:anyURI ;
	linkml:description "How likely the event or impact is, on whatever scale the adopter uses." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-ai-100-1/AiRmfImpact> , <https://w3id.org/lmodel/nist-ai-100-1/AiRmfRisk> ;
	linkml:owner <https://w3id.org/lmodel/nist-ai-100-1/AiRmfImpact> ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_likelihood"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_magnitude> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-ai-100-1/nist_ai_100_1_foundations"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_magnitude"^^xsd:anyURI ;
	linkml:description "How large the consequences are, on whatever scale the adopter uses." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-ai-100-1/AiRmfImpact> , <https://w3id.org/lmodel/nist-ai-100-1/AiRmfRisk> ;
	linkml:owner <https://w3id.org/lmodel/nist-ai-100-1/AiRmfImpact> ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_magnitude"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_management_challenge_measurement_challenges> a linkml:SlotDefinition ;
	linkml:description "The risk measurement challenges of section 1.2.1, under the challenge of risk measurement." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/AiRmfMeasurementChallenge> .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_management_challenge_name> a linkml:SlotDefinition ;
	linkml:description "Which challenge this is." ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/AiRmfManagementChallengeName> ;
	linkml:required true .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_management_challenges> a linkml:SlotDefinition ;
	linkml:description "The challenges for AI risk management of section 1.2." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/AiRmfManagementChallenge> .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_measurement_challenge_name> a linkml:SlotDefinition ;
	linkml:description "Which challenge this is." ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/AiRmfMeasurementChallengeName> ;
	linkml:required true .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_profile_kinds> a linkml:SlotDefinition ;
	linkml:description "Which of the publication's kinds of profile this is. A current profile for one use case is both." ;
	linkml:minimum_cardinality 1 ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/AiRmfProfileKind> ;
	linkml:required true .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_profile_setting> a linkml:SlotDefinition ;
	linkml:description "The sector, industry, technology, organization or end use the profile covers, such as hiring." .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_profile_subcategories> a linkml:SlotDefinition ;
	linkml:description "The subcategories the profile selects. An adopter may select from them rather than apply all." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_subcategory_identifier> .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_resource_address> a linkml:SlotDefinition ;
	linkml:description "The address NIST's catalog gives the source. The catalog gives none for a few." ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/uri> .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_resource_uuid> a linkml:SlotDefinition ;
	linkml:description "The UUID of the resource in the back matter of NIST's catalog." ;
	linkml:pattern "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" ;
	linkml:required true .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_risk_characteristics> a linkml:SlotDefinition ;
	linkml:description "The trustworthiness characteristics the risk bears on." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/AiRmfCharacteristicName> .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_risk_impacts> a linkml:SlotDefinition ;
	linkml:description "The impacts that contribute to the risk." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/AiRmfImpact> .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_risk_lifecycle_stages> a linkml:SlotDefinition ;
	linkml:description "The lifecycle stages where the risk is measured or arises." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName> .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_risk_priority> a linkml:SlotDefinition ;
	skos:note "MANAGE 1.3 speaks of risks deemed high priority and the publication sets no scale, so this is text." ;
	linkml:description "The priority the adopter gives the risk's treatment, on whatever scale it uses, as MANAGE 1.2 asks." .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_risk_responses> a linkml:SlotDefinition ;
	linkml:description "The responses chosen for the risk." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/AiRmfRiskResponse> .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_risk_system> a linkml:SlotDefinition ;
	linkml:description "The AI system the risk concerns." ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/AiRmfSystem> .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_risk_tolerance> a linkml:SlotDefinition ;
	linkml:description "The risk tolerance the risk is judged against, which GOVERN 1.3 and MAP 1.5 ask an adopter to document." ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/AiRmfRiskTolerance> .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_risk_tolerance_holder> a linkml:SlotDefinition ;
	linkml:description "The organization or AI actor whose tolerance this is." ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActor> .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_risk_tolerance_influences> a linkml:SlotDefinition ;
	linkml:description "What influences it, such as a law, a regulation, a policy or a norm." ;
	linkml:multivalued true .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_specific_risk_position> a linkml:SlotDefinition ;
	linkml:description "The item's position in Appendix B's list, which is not numbered." ;
	linkml:minimum_value "1"^^linkml:\@id ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/integer> ;
	linkml:required true .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_specific_risks> a linkml:SlotDefinition ;
	linkml:description "The AI-specific risks of Appendix B." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/AiRmfSpecificRisk> .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_subcategory_about> a linkml:SlotDefinition ;
	linkml:description "The Playbook's discussion of the outcome." ;
	linkml:multivalued true .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_subcategory_ai_actors> a linkml:SlotDefinition ;
	linkml:description "The AI actors the Playbook tags the outcome with." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName> .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_subcategory_documentation> a linkml:SlotDefinition ;
	linkml:description "What the Playbook suggests an organization document, mostly as questions." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/AiRmfDocumentationItem> .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_subcategory_id> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-ai-100-1/nist_ai_100_1_base"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_subcategory_id"^^xsd:anyURI ;
	linkml:description "The subcategory's identifier, such as GOVERN 1.1." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-ai-100-1/AiRmfSubcategory> ;
	linkml:owner <https://w3id.org/lmodel/nist-ai-100-1/AiRmfSubcategory> ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_subcategory_identifier> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_subcategory_id"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_subcategory_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-ai-100-1/nist_ai_100_1_base"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-ai-100-1/AiRmfSubcategoryIdentifier"^^xsd:anyURI ;
	linkml:description "A subcategory's identifier, its category's identifier, a dot and a number, such as GOVERN 1.1." ;
	linkml:pattern "^(GOVERN [1-6]|MAP [1-5]|MEASURE [1-4]|MANAGE [1-4])\\.[1-9][0-9]?$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-ai-100-1/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_subcategory_references> a linkml:SlotDefinition ;
	linkml:description "The Playbook's references for the outcome." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/AiRmfResource> .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_subcategory_suggested_actions> a linkml:SlotDefinition ;
	linkml:description "The steps the Playbook suggests towards the outcome. They are voluntary and are not a checklist." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/AiRmfSuggestedAction> .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_subcategory_topics> a linkml:SlotDefinition ;
	linkml:description "The topics the Playbook tags the outcome with. NIST keeps no closed list of them." ;
	linkml:multivalued true .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_subcategory_transparency_resources> a linkml:SlotDefinition ;
	linkml:description "The sources the Playbook names as AI transparency resources." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/AiRmfResource> .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_suggested_action_id> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-ai-100-1/nist_ai_100_1_rmf_core"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_suggested_action_id"^^xsd:anyURI ;
	linkml:description "The suggested action's identifier, such as SA-GOVERN_1.1-1." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-ai-100-1/AiRmfSuggestedAction> ;
	linkml:owner <https://w3id.org/lmodel/nist-ai-100-1/AiRmfSuggestedAction> ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_suggested_action_identifier> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_suggested_action_id"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_suggested_action_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-ai-100-1/nist_ai_100_1_rmf_core"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-ai-100-1/AiRmfSuggestedActionIdentifier"^^xsd:anyURI ;
	linkml:description "The identifier NIST's catalog gives a Playbook suggested action, such as SA-GOVERN_1.1-1. Each further number, as in SA-GOVERN_1.4-1.2, marks a sub-item." ;
	linkml:pattern "^SA-(GOVERN|MAP|MEASURE|MANAGE)_[1-6]\\.[1-9][0-9]?-[1-9][0-9]?(\\.[1-9][0-9]?)*$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-ai-100-1/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_system_actors> a linkml:SlotDefinition ;
	linkml:description "The AI actors with a role in the system's lifecycle, such as those MAP 1.6 says elicit its requirements." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActor> .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_system_deployment_settings> a linkml:SlotDefinition ;
	linkml:description "The settings the system is or will be deployed in, which MAP 1.1 asks an adopter to document." ;
	linkml:multivalued true .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_system_intended_purposes> a linkml:SlotDefinition ;
	linkml:description "What the system is for, and its potentially beneficial uses, which MAP 1.1 asks an adopter to document." ;
	linkml:multivalued true .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_system_lifecycle_stages> a linkml:SlotDefinition ;
	linkml:description "The lifecycle stages the record covers." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName> .
<https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_version> a linkml:SlotDefinition ;
	linkml:description "The edition in NIST's two-number form, such as 1.0." ;
	linkml:pattern "^[0-9]+\\.[0-9]+$" ;
	linkml:required true .
<https://w3id.org/lmodel/nist-ai-100-1/application_context> dcterms:title "Application Context" ;
	linkml:description "The setting the system is planned for and operated in." .
<https://w3id.org/lmodel/nist-ai-100-1/availability_of_reliable_metrics> dcterms:title "Availability of reliable metrics" ;
	linkml:description "There is no consensus on robust, verifiable methods, and metrics can be oversimplified or gamed." .
<https://w3id.org/lmodel/nist-ai-100-1/avoiding> dcterms:title "Avoiding" ;
	linkml:description "Not carrying out what creates the risk." .
<https://w3id.org/lmodel/nist-ai-100-1/boolean> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"boolean\"." ;
	skos:exactMatch "schema:Boolean"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "Bool" ;
	linkml:definition_uri "https://w3id.org/linkml/Boolean"^^xsd:anyURI ;
	linkml:description "A binary (true or false) value" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "bool" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-ai-100-1/both> dcterms:title "Both" ;
	linkml:description "Positive and negative at once." .
<https://w3id.org/lmodel/nist-ai-100-1/build_and_use_model> dcterms:title "Build and Use Model" ;
	linkml:description "Creating or selecting algorithms and training models." .
<https://w3id.org/lmodel/nist-ai-100-1/business_operations> dcterms:title "Business operations" ;
	linkml:description "To how an organization operates." .
<https://w3id.org/lmodel/nist-ai-100-1/collect_and_process_data> dcterms:title "Collect and Process Data" ;
	linkml:description "Gathering, validating and cleaning data, and recording what it holds." .
<https://w3id.org/lmodel/nist-ai-100-1/communities> dcterms:title "Communities" ;
	linkml:description "Communities of people." .
<https://w3id.org/lmodel/nist-ai-100-1/computational_and_statistical> dcterms:title "Computational and statistical" ;
	linkml:description "In datasets and algorithms, often from systematic errors due to samples that are not representative." .
<https://w3id.org/lmodel/nist-ai-100-1/cross_sectoral> dcterms:title "Cross-sectoral profile" ;
	linkml:description "Covers risks of models or applications used across use cases or sectors, or activities common to them, such as using large language models." .
<https://w3id.org/lmodel/nist-ai-100-1/curie> dcterms:conformsTo "https://www.w3.org/TR/curie/" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"curie\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	skos:note "in RDF serializations this MUST be expanded to a URI" , "in non-RDF serializations MAY be serialized as the compact representation" ;
	linkml:base "Curie" ;
	linkml:definition_uri "https://w3id.org/linkml/Curie"^^xsd:anyURI ;
	linkml:description "a compact URI" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-ai-100-1/current> dcterms:title "Current Profile" ;
	linkml:description "A temporal profile saying how AI is managed today and the related risks, in terms of current outcomes." .
<https://w3id.org/lmodel/nist-ai-100-1/data_and_input> dcterms:title "Data and Input" ;
	linkml:description "The data the system is built from and takes in." .
<https://w3id.org/lmodel/nist-ai-100-1/date> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date\"." , "URI is dateTime because OWL reasoners don't work with straight date or time" ;
	skos:exactMatch "schema:Date"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "XSDDate" ;
	linkml:definition_uri "https://w3id.org/linkml/Date"^^xsd:anyURI ;
	linkml:description "a date (year, month and day) in an idealized calendar" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#date"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-ai-100-1/date_or_datetime> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date_or_datetime\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/DateOrDatetime"^^xsd:anyURI ;
	linkml:description "Either a date or a datetime" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "https://w3id.org/linkml/DateOrDatetime"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-ai-100-1/datetime> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"datetime\"." ;
	skos:exactMatch "schema:DateTime"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "XSDDateTime" ;
	linkml:definition_uri "https://w3id.org/linkml/Datetime"^^xsd:anyURI ;
	linkml:description "The combination of a date and time" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#dateTime"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-ai-100-1/decimal> a linkml:TypeDefinition ;
	skos:broadMatch "schema:Number"^^xsd:anyURI ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"decimal\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "Decimal" ;
	linkml:definition_uri "https://w3id.org/linkml/Decimal"^^xsd:anyURI ;
	linkml:description "A real number with arbitrary precision that conforms to the xsd:decimal specification" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#decimal"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-ai-100-1/deploy_and_use> dcterms:title "Deploy and Use" ;
	linkml:description "Piloting, checking compatibility and compliance, managing change and evaluating user experience." .
<https://w3id.org/lmodel/nist-ai-100-1/description> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-ai-100-1/nist_ai_100_1_base"^^xsd:anyURI ;
	skos:mappingRelation "http://schema.org/description"^^xsd:anyURI ;
	skos:note "It carries the IRI of LOKF's description, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one description key." ;
